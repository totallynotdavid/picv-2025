# Shared secret the SvelteKit BFF uses to call the FastAPI backend.
# openssl rand -hex 32
BACKEND_SERVICE_TOKEN=

# Better Auth session secret for the web app. openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the web app (used by Better Auth + SvelteKit).
ORIGIN=http://localhost:3000

# Optional: comma-separated browser origins allowed to call the API directly.
# Normally empty. The browser talks to the BFF, not FastAPI.
ALLOWED_ORIGINS=

# Password for the control plane's database role (default name: tsdhn_app).
# Created by `tsdhn-compute-migrate`; the web app connects with it.
# openssl rand -hex 32
APP_DB_PASSWORD=

# Where a *browser* can reach MinIO. Presigned artifact URLs are signed
# against this, not the in-cluster endpoint the API dials.
MINIO_PUBLIC_ENDPOINT=localhost:9000
