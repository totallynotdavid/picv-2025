# PostgreSQL URL for the web app.
# The Compose stack creates this role before starting the app.
DATABASE_URL=postgresql://tsdhn_app:change-me@localhost:5432/tsdhn

ORIGIN="http://localhost:5173"

# Better Auth requires a high-entropy secret in production.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# FastAPI compute service. Only server code sends this token.
COMPUTE_API_URL="http://localhost:8000"
COMPUTE_API_TOKEN=""
